# --- Database -------------------------------------------------------------
# MongoDB Atlas connection string, or mongodb://127.0.0.1:27017/nuvora locally
MONGODB_URI=

# --- Auth -----------------------------------------------------------------
# Random 32+ char secret. Generate: openssl rand -base64 48
AUTH_SECRET=

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` locally, or the dashboard endpoint in production
STRIPE_WEBHOOK_SECRET=

# --- Cloudinary (product image uploads) -----------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Store config ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Free shipping kicks in at this subtotal (integer cents).
# Keep both in step — the public one only drives the cart progress bar.
FREE_SHIPPING_THRESHOLD_CENTS=9900
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_CENTS=9900
# Flat shipping charged below the threshold (integer cents)
FLAT_SHIPPING_CENTS=1495
# Sales tax as a decimal, e.g. 0.0825 for 8.25%. 0 disables tax.
TAX_RATE=0
